# Copy this file to .env.local and fill in real values before running the app.
# Only variables prefixed with VITE_ reach the client code, through import.meta.env.VITE_*.
# Everything here ends up in the public bundle: never put secrets in it.
# Type new variables in src/env.d.ts (interface ImportMetaEnv).
# https://vite.dev/guide/env-and-mode

# VITE_API_URL=https://api.example.com
